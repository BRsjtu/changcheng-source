.workshop-copy {
  margin-top: 16rpx;
  color: rgba(255, 253, 247, 0.86);
  font-size: 28rpx;
  line-height: 1.55;
}

.workshop-hero-cartoon {
  width: 150rpx;
  height: 150rpx;
}

.idea-card {
  position: relative;
  overflow: hidden;
}

.idea-card > view,
.idea-card > textarea {
  position: relative;
  z-index: 1;
}

.upload-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-height: 132rpx;
  padding: 22rpx;
  border: 2rpx solid rgba(31, 109, 61, 0.36);
  border-radius: 16rpx;
  background: #f0f7ec;
  box-shadow: 0 8rpx 18rpx rgba(31, 109, 61, 0.08);
}

.upload-card-pressed {
  background: #e5f1df;
  transform: scale(0.99);
}

.upload-card[disabled] {
  opacity: 0.58;
}

.upload-icon {
  display: flex;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: #fff;
  background: #1f6d3d;
}

.upload-plus {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.upload-plus::before,
.upload-plus::after {
  position: absolute;
  left: 50%;
  top: 50%;
  content: '';
  border-radius: 999rpx;
  background: #fff;
  transform: translate(-50%, -50%);
}

.upload-plus::before {
  width: 30rpx;
  height: 5rpx;
}

.upload-plus::after {
  width: 5rpx;
  height: 30rpx;
}

.upload-copy {
  min-width: 0;
  margin-left: 20rpx;
  text-align: left;
}

.upload-title {
  color: #125d34;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
}

.upload-hint {
  margin-top: 8rpx;
  color: #66705f;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
}

.idea-mascot {
  position: absolute;
  right: 12rpx;
  top: 8rpx;
  z-index: 0;
  width: 104rpx;
  height: 104rpx;
  opacity: 0.22;
}

.site-configurator {
  padding: 16rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  border-radius: 22rpx;
  background: #f5f5f7;
}

.site-configurator-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  padding: 2rpx 4rpx 14rpx;
}

.site-configurator-head text {
  flex: 0 0 auto;
  color: #86868b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.2;
}

.site-configurator-head view {
  min-width: 0;
  overflow: hidden;
  color: #1d1d1f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.site-option {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  min-height: 92rpx;
  padding: 14rpx 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.08);
  border-radius: 18rpx;
  background: #fff;
  box-shadow: none;
  text-align: left;
}

.site-option::after {
  border: 0;
}

.site-option text {
  display: block;
  max-width: 100%;
  overflow: hidden;
  color: #1d1d1f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-option view {
  max-width: 100%;
  margin-top: 7rpx;
  overflow: hidden;
  color: #86868b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.site-option.selected {
  border-color: #007aff;
  background: #f5faff;
}

.site-option.selected text {
  color: #0066cc;
}

.site-option.selected view {
  color: #3b6f9f;
}

.site-option-pressed {
  background: #f2f2f7;
  transform: scale(0.99);
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.type-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  padding: 8rpx 12rpx;
  color: #273927;
  background: #fffdf7;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

.type-btn.active {
  color: #fff;
  background: #273927;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.photo-item {
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
  border-radius: 14rpx;
  background: #ece8da;
}

.photo-preview {
  width: 100%;
  height: 220rpx;
  border-radius: 14rpx;
}

.photo-remove {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  padding: 0;
  border-radius: 50%;
  color: #fff;
  background: rgba(31, 45, 34, 0.82);
  font-size: 36rpx;
  line-height: 52rpx;
}

textarea {
  width: 100%;
  min-height: 150rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f5f1e8;
  color: #263128;
  font-size: 28rpx;
  line-height: 1.5;
}

.generate-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.generate-btn,
.cancel-btn {
  margin-top: 0;
}

.generation-progress {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f5f1e8;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #3d463b;
  font-size: 24rpx;
  font-weight: 700;
}

.progress-head text:first-child {
  min-width: 0;
  line-height: 1.4;
}

.progress-scene {
  position: relative;
  height: 58rpx;
  margin: 8rpx 0 -2rpx;
}

.progress-mascot {
  position: absolute;
  bottom: 0;
  width: 58rpx;
  height: 58rpx;
  filter: drop-shadow(0 6rpx 8rpx rgba(43, 45, 35, 0.12));
  transform: translateX(-50%);
  transform-origin: 50% 100%;
  transition: left 0.4s ease;
  animation: mascot-run 0.72s ease-in-out infinite;
}

@keyframes mascot-run {
  0% {
    transform: translateX(-50%) translateY(0) rotate(-4deg) scaleX(1);
  }
  25% {
    transform: translateX(-50%) translateY(-8rpx) rotate(5deg) scaleX(0.98);
  }
  50% {
    transform: translateX(-50%) translateY(0) rotate(4deg) scaleX(1.02);
  }
  75% {
    transform: translateX(-50%) translateY(-6rpx) rotate(-5deg) scaleX(0.99);
  }
  100% {
    transform: translateX(-50%) translateY(0) rotate(-4deg) scaleX(1);
  }
}

.progress-track {
  overflow: hidden;
  height: 14rpx;
  border-radius: 999rpx;
  background: #e1e7da;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1f6d3d, #e5c66e);
  transition: width 0.4s ease;
}

.progress-note {
  margin-top: 12rpx;
  color: #66705f;
  font-size: 23rpx;
  line-height: 1.45;
}

.result-card {
  padding: 18rpx;
}

.result-image {
  width: 100%;
  border-radius: 14rpx;
  background: #ece8da;
}

.result-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.creation-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.creation-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(43, 45, 35, 0.06);
}

.creation-card image {
  width: 100%;
  height: 240rpx;
  background: #ece8da;
}

.creation-card view {
  padding: 14rpx 16rpx 2rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.creation-card text {
  display: block;
  padding: 0 16rpx 16rpx;
  color: #66705f;
  font-size: 24rpx;
}
