.gallery-hero {
  margin-bottom: 20rpx;
}

.gallery-copy {
  margin-top: 16rpx;
  color: rgba(255, 253, 247, 0.86);
  font-size: 28rpx;
  line-height: 1.55;
}

.gallery-filter-row {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 0;
  overflow-x: auto;
}

.gallery-filter {
  flex: 0 0 auto;
  min-width: 116rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  color: #65705f;
  background: #fffdf7;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.gallery-filter.active {
  color: #fff;
  background: #1f6d3d;
}

.gallery-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.gallery-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(43, 45, 35, 0.06);
}

.gallery-image {
  display: block;
  width: 100%;
  height: 420rpx;
  background: #ece8da;
}

.gallery-body {
  padding: 18rpx;
}

.gallery-title {
  min-width: 0;
  color: #263128;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.gallery-note {
  margin-top: 10rpx;
  color: #3d463b;
  font-size: 26rpx;
  line-height: 1.5;
}

.site-link {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  color: #1f6d3d;
  background: #e8f1e5;
  font-size: 25rpx;
  font-weight: 800;
}
