.journal-hero {
  margin-bottom: 18rpx;
}

.journal-copy {
  margin-top: 16rpx;
  color: rgba(255, 253, 247, 0.86);
  font-size: 28rpx;
  line-height: 1.55;
}

.journal-hero-cartoon {
  right: 12rpx;
  bottom: 8rpx;
  width: 150rpx;
  height: 150rpx;
}

.forgotten-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 118rpx;
  margin: 20rpx 0 8rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid rgba(138, 75, 32, 0.22);
  border-radius: 16rpx;
  background: #fff8e8;
  box-shadow: 0 10rpx 22rpx rgba(138, 75, 32, 0.08);
  text-align: left;
}

.forgotten-entry:active {
  background: #fff1d6;
  transform: scale(0.99);
}

.forgotten-entry-icon {
  display: flex;
  flex: 0 0 60rpx;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  color: #fff;
  background: #8a4b20;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.forgotten-entry-copy {
  flex: 1;
  min-width: 0;
}

.forgotten-entry-copy view {
  color: #8a4b20;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.forgotten-entry-copy text {
  display: block;
  margin-top: 8rpx;
  color: #6d5b42;
  font-size: 24rpx;
  line-height: 1.4;
}

.forgotten-entry-arrow {
  flex: 0 0 42rpx;
  color: #8a4b20;
  text-align: right;
  font-size: 54rpx;
  font-weight: 300;
  line-height: 1;
}

.filter-row {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 0;
  overflow-x: auto;
}

.filter-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-height: 64rpx;
  padding: 0 24rpx;
  color: #65705f;
  background: #fffdf7;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.filter-btn.active {
  color: #fff;
  background: #1f6d3d;
}

.site-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.site-card {
  display: flex;
  gap: 20rpx;
  padding: 18rpx;
}

.cover {
  position: relative;
  overflow: hidden;
  display: flex;
  flex: 0 0 148rpx;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  min-height: 164rpx;
  border-radius: 14rpx;
  color: #fffdf7;
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
}

.cover-image,
.cover-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-image {
  z-index: 0;
}

.cover-shade {
  z-index: 0;
  background: linear-gradient(180deg, rgba(24, 34, 25, 0.18), rgba(24, 34, 25, 0.68));
}

.cover text {
  position: relative;
  z-index: 1;
  padding: 0 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.28);
}

.site-body {
  flex: 1;
  min-width: 0;
}

.site-name {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.site-body .row {
  align-items: flex-start;
}

.story {
  display: -webkit-box;
  margin-top: 14rpx;
  overflow: hidden;
  color: #3d463b;
  font-size: 27rpx;
  line-height: 1.5;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.priority-line {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.priority-line.high {
  color: #b42318;
  background: #fff0ed;
}

.priority-line.medium {
  color: #8a4b20;
  background: #fff3d8;
}

.priority-line.low {
  color: #1f6d3d;
  background: #e8f1e5;
}
