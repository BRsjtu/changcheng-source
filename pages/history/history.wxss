.history-copy {
  margin-top: 16rpx;
  color: rgba(255, 253, 247, 0.86);
  font-size: 28rpx;
  line-height: 1.55;
}

.history-hero-cartoon {
  right: 12rpx;
  bottom: 10rpx;
  width: 144rpx;
  height: 144rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.patrol-summary {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 22rpx;
}

.patrol-summary > view {
  padding: 16rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 247, 0.14);
}

.patrol-summary text {
  display: block;
  text-align: center;
}

.patrol-summary text:first-child {
  font-size: 36rpx;
  font-weight: 900;
}

.patrol-summary text:last-child {
  margin-top: 4rpx;
  color: rgba(255, 253, 247, 0.78);
  font-size: 22rpx;
}

.history-filter-row {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 0;
  overflow-x: auto;
}

.gallery-entry {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-height: 116rpx;
  margin: 22rpx 0;
  padding: 20rpx 24rpx;
  border: 2rpx solid rgba(31, 109, 61, 0.22);
  border-radius: 16rpx;
  background: #eef7ea;
  text-align: left;
}

.gallery-entry view {
  color: #125d34;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.25;
}

.gallery-entry text {
  margin-top: 8rpx;
  color: #66705f;
  font-size: 24rpx;
  line-height: 1.35;
}

.history-filter {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 116rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  color: #65705f;
  background: #fffdf7;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.history-filter.active {
  color: #fff;
  background: #1f6d3d;
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #ece8da;
}

.swipe-row:last-child {
  border-bottom: 0;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 172rpx;
  border-radius: 0;
  color: #fff;
  background: #d92d20;
  font-size: 28rpx;
  font-weight: 800;
}

.history-row {
  position: relative;
  z-index: 1;
  padding: 18rpx 0;
  background: #fffdf7;
  transition: transform 0.16s ease;
}

.history-row .row {
  align-items: flex-start;
}

.history-row:last-child {
  border-bottom: 0;
}

.history-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.history-note {
  margin-top: 10rpx;
  color: #3d463b;
  font-size: 27rpx;
  line-height: 1.5;
}

.history-photo {
  display: block;
  width: 100%;
  height: 320rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #ece8da;
}

.share-btn {
  min-height: 64rpx;
  margin-top: 14rpx;
  padding: 0 20rpx;
  color: #1f6d3d;
  background: #e8f1e5;
  font-size: 25rpx;
  font-weight: 800;
}

.history-creation-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.history-creation {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(43, 45, 35, 0.06);
}

.creation-preview {
  display: block;
}

.history-creation image {
  width: 100%;
  height: 240rpx;
  background: #ece8da;
}

.history-creation view {
  padding: 14rpx 16rpx 2rpx;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.history-creation text {
  display: block;
  padding: 0 16rpx 16rpx;
  color: #66705f;
  font-size: 24rpx;
}

.creation-share {
  margin: 0 16rpx 16rpx;
}
