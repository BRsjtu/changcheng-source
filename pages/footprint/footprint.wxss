.footprint-page {
  padding-bottom: 36rpx;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 26rpx;
}

.footprint-hero-cartoon {
  top: 24rpx;
  right: 18rpx;
  bottom: auto;
  width: 122rpx;
  height: 122rpx;
}

.hero-stats > view {
  padding: 18rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 247, 0.14);
}

.stat-num,
.stat-label {
  display: block;
  text-align: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 900;
}

.stat-label {
  margin-top: 4rpx;
  color: rgba(255, 253, 247, 0.8);
  font-size: 22rpx;
}

.role-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  padding-right: 118rpx;
}

.role-layout {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.role-copy {
  min-width: 0;
}

.role-title {
  font-size: 30rpx;
  font-weight: 800;
}

.mode-help {
  margin-top: 8rpx;
  color: #8a4b20;
  font-size: 24rpx;
  line-height: 1.35;
}

.role-switch {
  display: flex;
  gap: 8rpx;
  width: auto;
  max-width: 100%;
  padding: 6rpx;
  border-radius: 14rpx;
  background: #eef0e7;
}

.role-mascot {
  position: absolute;
  right: 24rpx;
  top: 20rpx;
  z-index: 2;
  width: 88rpx;
  height: 82rpx;
  opacity: 0.96;
}

.role-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 164rpx;
  min-height: 62rpx;
  padding: 0 12rpx;
  color: #65705f;
  background: transparent;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.role-btn.active {
  color: #fff;
  background: #1f6d3d;
}

.great-map {
  width: 100%;
  height: 650rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.selected-card {
  margin-top: 18rpx;
  overflow: hidden;
}

.site-title {
  font-size: 34rpx;
  font-weight: 900;
}

.site-story {
  margin-top: 18rpx;
  color: #3d463b;
  font-size: 28rpx;
  line-height: 1.55;
}

.distance-line {
  margin-top: 14rpx;
  color: #8a4b20;
  font-size: 26rpx;
}

.visit-photo-card {
  position: relative;
  overflow: hidden;
  margin-top: 18rpx;
  border-radius: 14rpx;
  background: #ece8da;
}

.visit-photo-card image {
  display: block;
  width: 100%;
  height: 300rpx;
}

.photo-clear {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  min-width: 108rpx;
  min-height: 52rpx;
  padding: 0 16rpx;
  color: #fff;
  background: rgba(39, 57, 39, 0.82);
  font-size: 24rpx;
}

.photo-action-row {
  display: grid;
  grid-template-columns: minmax(0, 276rpx) minmax(0, 1fr);
  gap: 16rpx;
  align-items: center;
  margin-top: 18rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-grid .primary-btn,
.action-grid .ghost-btn,
.photo-action-row .ghost-btn {
  width: 100%;
  min-width: 0;
  padding: 0 16rpx;
}

.swipe-row {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #ece8da;
}

.swipe-row:last-child {
  border-bottom: 0;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  width: 172rpx;
  border-radius: 0;
  color: #fff;
  background: #d92d20;
  font-size: 28rpx;
  font-weight: 800;
}

.record-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  background: #fffdf7;
  transition: transform 0.16s ease;
}

.record-row > view:first-child {
  min-width: 0;
}

.record-main {
  flex: 1;
}

.record-thumb {
  flex: 0 0 92rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 12rpx;
  background: #ece8da;
}

.record-row:last-child {
  border-bottom: 0;
}

.record-name {
  font-size: 30rpx;
  font-weight: 800;
}
