page {
  min-height: 100%;
  color: #263128;
  background: #f5f1e8;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 30rpx;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

button {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1;
  text-align: center;
  white-space: normal;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f1e8;
}

.hero-band {
  position: relative;
  overflow: hidden;
  min-height: 220rpx;
  padding: 28rpx;
  padding-right: 188rpx;
  border-radius: 16rpx;
  color: #fffdf7;
  background: linear-gradient(135deg, #273927 0%, #1f6d3d 100%);
}

.hero-band > view:not(.hero-cartoon-wrap),
.hero-band > text {
  position: relative;
  z-index: 1;
}

.hero-cartoon-wrap {
  position: absolute;
  right: 16rpx;
  bottom: 10rpx;
  z-index: 2;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 170rpx;
  height: 170rpx;
  pointer-events: none;
}

.hero-cartoon {
  display: block;
  width: 100%;
  height: 100%;
}

.eyebrow {
  color: rgba(255, 253, 247, 0.8);
  font-size: 24rpx;
}

.h1 {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
}

.subtle {
  color: #66705f;
  font-size: 26rpx;
  line-height: 1.5;
}

.section-title {
  margin: 30rpx 0 16rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.card {
  padding: 24rpx;
  border: 1rpx solid rgba(39, 57, 39, 0.08);
  border-radius: 16rpx;
  background: #fffdf7;
  box-shadow: 0 10rpx 24rpx rgba(43, 45, 35, 0.06);
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.between {
  justify-content: space-between;
}

.row > view {
  min-width: 0;
}

.primary-btn,
.secondary-btn,
.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.primary-btn {
  color: #fff;
  background: #1f6d3d;
}

.secondary-btn {
  color: #273927;
  background: #e5c66e;
}

.ghost-btn {
  color: #1f6d3d;
  background: #e8f1e5;
}

.danger-note {
  color: #8a4b20;
  font-size: 24rpx;
  line-height: 1.5;
}

.pill {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  max-width: 220rpx;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #1f6d3d;
  background: #e8f1e5;
  font-size: 24rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  padding: 42rpx 24rpx;
  color: #66705f;
  text-align: center;
}
